RewriteEngine On

# Redirect everything to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Block access to sensitive files
<FilesMatch "\.(sqlite|sqlite3|db|sql|env|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Block .git directory
<Directory ".git">
    Require all denied
</Directory>
